  "components": {
    "schemas": {
      "ActionInput": {
        "properties": {
          "nome": {
            "type": "string",
            "maxLength": 160,
            "minLength": 2,
            "title": "Nome"
          },
          "categoria": {
            "type": "string",
            "maxLength": 80,
            "title": "Categoria",
            "default": ""
          },
          "descricao": {
            "type": "string",
            "maxLength": 4000,
            "title": "Descricao",
            "default": ""
          },
          "resumo_publico": {
            "type": "string",
            "maxLength": 1000,
            "title": "Resumo Publico",
            "default": ""
          },
          "inicio_em": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Inicio Em"
          },
          "fim_em": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fim Em"
          },
          "locais": {
            "items": {
              "$ref": "#/components/schemas/Location"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Locais"
          },
          "versao": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Versao",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nome",
          "locais"
        ],
        "title": "ActionInput"
      },
      "BeneficiaryInput": {
        "properties": {
          "nome": {
            "type": "string",
            "maxLength": 160,
            "minLength": 2,
            "title": "Nome"
          },
          "municipio_residencia_ibge": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Municipio Residencia Ibge"
          },
          "local_indice": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Local Indice"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nome"
        ],
        "title": "BeneficiaryInput"
      },
      "FileStart": {
        "properties": {
          "formato": {
            "type": "string",
            "enum": [
              "pdf",
              "csv",
              "json"
            ],
            "title": "Formato"
          },
          "tamanho": {
            "type": "integer",
            "maximum": 8388608.0,
            "exclusiveMinimum": 0.0,
            "title": "Tamanho"
          },
          "hash_arquivo": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Hash Arquivo"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "formato",
