          "$ref": "#/$defs/Totals"
        }
      },
      "required": [
        "quantidadeAcoes",
        "quantidadeParticipacoes",
        "quantidadePessoasContempladas",
        "quantidadeMunicipios",
        "acoesSemData",
        "municipios",
        "semDistribuicaoMunicipal"
      ],
      "title": "Aggregates",
      "type": "object"
    },
    "Municipality": {
      "additionalProperties": false,
      "properties": {
        "ibge": {
          "pattern": "^25[0-9]{5}$",
          "title": "Ibge",
          "type": "string"
        },
        "nome": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Nome",
          "type": "string"
        },
        "uf": {
          "const": "PB",
          "title": "Uf",
          "type": "string"
        },
        "quantidadeAcoes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Quantidadeacoes",
          "type": "integer"
        },
        "acoesSemDistribuicao": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Acoessemdistribuicao",
          "type": "integer"
        },
        "participacoesMunicipioUnico": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Participacoesmunicipiounico",
          "type": "integer"
        },
        "pessoasContempladasMunicipioUnico": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Pessoascontempladasmunicipiounico",
          "type": "integer"
        }
      },
      "required": [
        "ibge",
        "nome",
        "uf",
        "quantidadeAcoes",
        "acoesSemDistribuicao",
        "participacoesMunicipioUnico",
        "pessoasContempladasMunicipioUnico"
      ],
      "title": "Municipality",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "tipo": {
          "const": "acoes_publicadas_na_origem",
          "title": "Tipo",
          "type": "string"
        },
        "filtrosAplicados": {
          "items": {
            "type": "string"
          },
          "maxItems": 0,
          "title": "Filtrosaplicados",
          "type": "array"
        },
        "filtrosNaoAplicados": {
          "items": {
            "enum": [
              "ano",
              "mes",
              "status",
              "servico",
              "eixoDemografico",
              "categoriaDemografica",
              "servicosExcluidos"
            ],
            "type": "string"
          },
          "maxItems": 7,
          "title": "Filtrosnaoaplicados",
          "type": "array"
        },
        "pessoas": {
          "const": "contempladas nas ações, sem deduplicação entre ações",
          "title": "Pessoas",
          "type": "string"
        }
      },
      "required": [
        "tipo",
        "filtrosAplicados",
        "filtrosNaoAplicados",
        "pessoas"
      ],
      "title": "Scope",
      "type": "object"
    },
    "Totals": {
      "additionalProperties": false,
      "properties": {
        "quantidadeAcoes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Quantidadeacoes",
          "type": "integer"
        },
        "quantidadeParticipacoes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Quantidadeparticipacoes",
          "type": "integer"
        },
        "quantidadePessoasContempladas": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Quantidadepessoascontempladas",
          "type": "integer"
        }
      },
      "required": [
        "quantidadeAcoes",
        "quantidadeParticipacoes",
        "quantidadePessoasContempladas"
      ],
      "title": "Totals",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "versaoCalculo": {
      "const": "1.0",
      "title": "Versaocalculo",
      "type": "string"
    },
    "fonte": {
      "const": "ac-actions-map",
      "title": "Fonte",
      "type": "string"
    },
    "escopo": {
      "$ref": "#/$defs/Scope"
    },
    "status": {
      "enum": [
        "disponivel",
        "indisponivel"
      ],
      "title": "Status",
      "type": "string"
    },
    "codigo": {
      "anyOf": [
        {
          "enum": [
            "CONFIGURACAO_AUSENTE",
            "CONFIGURACAO_INVALIDA",
            "LIMITE_ORIGEM",
            "EXPORTACAO_EXPIRADA",
            "CONTRATO_INVALIDO",
            "ORIGEM_INDISPONIVEL",
            "LIMITE_PAYLOAD"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Codigo"
    },
    "geracao": {
      "anyOf": [
        {
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Geracao"
    },
    "capturadoEmIso": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Capturadoemiso"
    },
    "expiraEmIso": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expiraemiso"
    },
    "dados": {
      "anyOf": [
        {
          "$ref": "#/$defs/Aggregates"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "versaoCalculo",
    "fonte",
    "escopo",
    "status",
    "codigo",
    "geracao",
    "capturadoEmIso",
    "expiraEmIso",
    "dados"
  ],
  "title": "ActionsBlock",
  "type": "object"
}
