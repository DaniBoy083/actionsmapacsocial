        "quantidadeAcoes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Quantidadeacoes",
          "type": "integer"
        },
        "quantidadeParticipacoes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Quantidadeparticipacoes",
          "type": "integer"
        },
        "quantidadePessoasContempladas": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Quantidadepessoascontempladas",
          "type": "integer"
        },
        "quantidadeMunicipios": {
          "maximum": 223,
          "minimum": 0,
          "title": "Quantidademunicipios",
          "type": "integer"
        },
        "acoesSemData": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Acoessemdata",
          "type": "integer"
        },
        "municipios": {
          "items": {
            "$ref": "#/$defs/Municipality"
