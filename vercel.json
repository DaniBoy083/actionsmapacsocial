{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "framework": "nextjs",
      "installCommand": "npm ci",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "ACTIONS_BACKEND_URL"
        }
      ]
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "buildCommand": "python -m app.check_deployment"
    }
  },
  "rewrites": [
    { "source": "/api/v1/health", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
