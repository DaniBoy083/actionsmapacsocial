# Next.js: endereço privado do FastAPI. Nunca usar NEXT_PUBLIC_ para segredos.
ACTIONS_API_URL=http://127.0.0.1:8000
# Backend: leitura da identidade institucional; obter configuração com Tecnologia.
DATABASE_URL=
# Produção: credencial restrita do módulo (somente backend), preferencial aos aliases Neon.
ACTIONS_DATABASE_URL=
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
AGENDA_WEB_URL=
# Persistência isolada local. Não aponta para o PostgreSQL institucional.
ACTIONS_STORAGE_URL=sqlite:///./backend/private/actions.sqlite3
# Gere com scripts/setup_local.py (sem imprimir os valores).
SESSION_SECRET=
BENEFICIARIES_KEY=
# Receptor autenticado da Agenda, contrato agregado 1.1.
AGENDA_SUMMARIES_URL=
AGENDA_SERVICE_TOKEN=
